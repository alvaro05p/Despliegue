<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd" 
         version="3.1">

  <!-- Servlet for customer registration -->
  <servlet>
    <servlet-name>CustomerRegistrationServlet</servlet-name>
    <servlet-class>com.shop.CustomerRegistrationServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CustomerRegistrationServlet</servlet-name>
    <url-pattern>/register</url-pattern>
  </servlet-mapping>

  <!-- Servlet for customer login -->
  <servlet>
    <servlet-name>CustomerLoginServlet</servlet-name>
    <servlet-class>com.shop.CustomerLoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CustomerLoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <!-- Servlet to show the shop and items -->
  <servlet>
    <servlet-name>ShopServlet</servlet-name>
    <servlet-class>com.shop.ShopServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ShopServlet</servlet-name>
    <url-pattern>/shop</url-pattern>
  </servlet-mapping>

  <!-- Servlet to process item selection and calculate total price -->
  <servlet>
    <servlet-name>PurchaseServlet</servlet-name>
    <servlet-class>com.shop.PurchaseServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PurchaseServlet</servlet-name>
    <url-pattern>/purchase</url-pattern>
  </servlet-mapping>

  <!-- Servlet to confirm the purchase and save it in the database -->
  <servlet>
    <servlet-name>ConfirmPurchaseServlet</servlet-name>
    <servlet-class>com.shop.ConfirmPurchaseServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ConfirmPurchaseServlet</servlet-name>
    <url-pattern>/confirmPurchase</url-pattern>
  </servlet-mapping>

  <!-- Servlet for seller login -->
  <servlet>
    <servlet-name>SellerLoginServlet</servlet-name>
    <servlet-class>com.shop.SellerLoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SellerLoginServlet</servlet-name>
    <url-pattern>/sellerLogin</url-pattern>
  </servlet-mapping>

  <!-- Servlet to show the seller dashboard -->
  <servlet>
    <servlet-name>SellerDashboardServlet</servlet-name>
    <servlet-class>com.shop.SellerDashboardServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SellerDashboardServlet</servlet-name>
    <url-pattern>/sellerDashboard</url-pattern>
  </servlet-mapping>

  <!-- Servlet to show customer purchase history -->
  <servlet>
    <servlet-name>PurchaseHistoryServlet</servlet-name>
    <servlet-class>com.shop.PurchaseHistoryServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PurchaseHistoryServlet</servlet-name>
    <url-pattern>/purchaseHistory</url-pattern>
  </servlet-mapping>

  <!-- Welcome page configuration -->
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <servlet>
    <servlet-name>ProductUploadServlet</servlet-name>
    <servlet-class>com.shop.ProductUploadServlet</servlet-class>
  </servlet>

  <servlet-mapping>
      <servlet-name>ProductUploadServlet</servlet-name>
      <url-pattern>/uploadProduct</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>HomeServlet</servlet-name>
    <servlet-class>com.shop.HomeServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>HomeServlet</servlet-name>
    <url-pattern>/home</url-pattern>
  </servlet-mapping>

</web-app>
